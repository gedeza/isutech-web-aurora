# Backend Environment Configuration
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=4000
NODE_ENV=development

# PostgreSQL Database Configuration
# For local development:
DATABASE_URL="postgresql://username:password@localhost:5432/isutech?schema=public"
# For Hetzner server (example):
# DATABASE_URL="postgresql://isutech_user:your_password@localhost:5432/isutech_db?schema=public"

# JWT Secret (generate a strong random string)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Admin User (for seeding)
ADMIN_NAME="Admin User"
ADMIN_EMAIL=admin@isutech.co.za
ADMIN_PASSWORD=changeme123

# Email Configuration (optional - for notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:8082,http://localhost:5173,https://www.isutech.co.za

# File Upload Settings
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads
